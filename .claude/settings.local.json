{
  "permissions": {
    "allow": [
      "Bash(find . -name \"tmpclaude-*-cwd\" -type f -delete:*)",
      "Bash(del /s /q tmpclaude-*-cwd:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "find . -name \"tmpclaude-*-cwd\" -type f -delete 2>/dev/null || del /s /q tmpclaude-*-cwd 2>nul",
            "statusMessage": "Cleaning up tmpclaude temp files..."
          }
        ]
      }
    ]
  }
}
