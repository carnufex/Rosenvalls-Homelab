proxmox = {
  name         = "pve"
  cluster_name = "pve"
  endpoint     = "https://192.168.1.111:8006/"
  insecure     = true
  username     = "root@pam"
  api_token    = "root@pam!terraform=your-token-here"
}

cluster_name     = "talos-cluster"
cluster_endpoint = "192.168.1.200" # VIP
gateway          = "192.168.1.1"
talos_version    = "v1.12.11"

# Disabled by default. Set enabled = true only after supplying at least one
# non-sensitive SSH public key and confirming the WD Red disk is available.
# Keep agent_enabled false until Task 4 guest bootstrap installs and starts
# qemu-guest-agent; then set it true in the local terraform.tfvars.
nfs_server = {
  enabled            = false
  host_node          = "desktop"
  vm_id              = 8011
  name               = "nfs-01"
  ip                 = "192.168.1.231"
  gateway            = "192.168.1.1"
  boot_datastore     = "local-lvm"
  data_datastore     = "WD-red"
  data_disk_size_gib = 2048
  agent_enabled      = false
  ssh_public_keys    = []
}

nodes_config = {
  "control-01" = {
    host_node     = "pve"
    machine_type  = "controlplane"
    boot_disk_size_gib = 64
    ip            = "192.168.1.201"
    vm_id         = 101
    cpu           = 2
    ram_dedicated = 4096
    igpu          = false
    extra_labels = {
      "homelab.rosenvall.se/proxmox-host" = "desktop"
      "topology.kubernetes.io/zone"       = "desktop"
    }
  }
  "worker-01" = {
    host_node     = "pve"
    machine_type  = "worker"
    boot_disk_size_gib = 64
    ip            = "192.168.1.211"
    vm_id         = 201
    cpu           = 4
    ram_dedicated = 8192
    igpu          = false
    extra_labels = {
      "homelab.rosenvall.se/lan-special" = "true"
      "homelab.rosenvall.se/proxmox-host" = "desktop"
      "topology.kubernetes.io/zone"       = "desktop"
    }
  }
  # Example second physical host capacity node.
  # "worker-04" = {
  #   host_node          = "host1"
  #   machine_type       = "worker"
  #   longhorn_create_default_disk = false # host1 example has only a 30G Longhorn disk; keep it compute-only unless enlarged.
  #   boot_disk_size_gib = 32
  #   ip                 = "192.168.1.214"
  #   vm_id              = 8005
  #   cpu                = 4
  #   ram_dedicated      = 8192
  #   igpu               = false
  #   disks = {
  #     longhorn = {
  #       device      = "/dev/sdb"
  #       size        = "30G"
  #       type        = "scsi"
  #       mountpoint  = "/var/lib/longhorn"
  #       unit_number = 1
  #     }
  #   }
  #   extra_labels = {
  #     "homelab.rosenvall.se/proxmox-host" = "host1"
  #     "topology.kubernetes.io/zone"       = "host1"
  #   }
  # }
  # Example compute-only worker on a smaller Proxmox host. Setting disks to an
  # explicit empty map prevents inheriting the default 100G Longhorn disk.
  # "worker-05" = {
  #   host_node                    = "secondary-pve"
  #   machine_type                 = "worker"
  #   longhorn_create_default_disk = false
  #   boot_disk_size_gib           = 32
  #   ip                           = "192.168.1.215"
  #   vm_id                        = 8006
  #   cpu                          = 4
  #   ram_dedicated                = 6144
  #   igpu                         = false
  #   disks                        = {}
  #   extra_labels = {
  #     "homelab.rosenvall.se/compute-only" = "true"
