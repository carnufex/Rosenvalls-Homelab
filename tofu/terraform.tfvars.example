  #     longhorn = {
  #       device      = "/dev/sdb"
  #       size        = "30G"
  #       type        = "scsi"
  #       mountpoint  = "/var/lib/longhorn"
  #       unit_number = 1
  #     }
  #   }
  #   extra_labels = {
  #     "homelab.rosenvall.se/proxmox-host" = "host1"
  #     "topology.kubernetes.io/zone"       = "host1"
  #   }
  # }
}
