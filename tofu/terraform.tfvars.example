proxmox = {
  name         = "pve"
  cluster_name = "pve"
  endpoint     = "https://192.168.1.100:8006/"
  insecure     = true
  username     = "root@pam"
  api_token    = "root@pam!terraform=your-token-here"
}

cluster_name     = "talos-cluster"
cluster_endpoint = "192.168.1.200" # VIP
gateway          = "192.168.1.1"
talos_version    = "v1.8.3"

nodes_config = {
  "control-01" = {
    host_node     = "pve"
    machine_type  = "controlplane"
    boot_disk_size_gib = 64
    ip            = "192.168.1.201"
    vm_id         = 101
    cpu           = 2
    ram_dedicated = 4096
    igpu          = false
  }
  "worker-01" = {
    host_node     = "pve"
    machine_type  = "worker"
    boot_disk_size_gib = 64
    ip            = "192.168.1.211"
    vm_id         = 201
    cpu           = 4
    ram_dedicated = 8192
    igpu          = false
    extra_labels = {
      "homelab.rosenvall.se/lan-special" = "true"
    }
  }
}

media_nfs = {
  name               = "media-nfs-01"
  host_node          = "desktop"
  ip                 = "192.168.1.230"
  vm_id              = 8010
  cpu                = 2
  ram_dedicated      = 4096
  boot_disk_size_gib = 32
  boot_datastore     = "local-lvm"
  image_datastore    = "local"
  data_datastore     = "WD-red"
  data_disk_size_gib = 4500
  allowed_clients = [
    "192.168.1.211(rw,sync,no_subtree_check)",
    "192.168.1.212(rw,sync,no_subtree_check)",
    "192.168.1.213(rw,sync,no_subtree_check)",
  ]
}
