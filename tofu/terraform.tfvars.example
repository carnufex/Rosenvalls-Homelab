proxmox = {
  name         = "pve"
  cluster_name = "pve"
  endpoint     = "https://192.168.1.111:8006/"
  insecure     = true
  username     = "root@pam"
  api_token    = "root@pam!terraform=your-token-here"
}

cluster_name     = "talos-cluster"
cluster_endpoint = "192.168.1.200" # VIP
gateway          = "192.168.1.1"
talos_version    = "v1.8.3"

nodes_config = {
  "control-01" = {
    host_node     = "pve"
    machine_type  = "controlplane"
    boot_disk_size_gib = 64
    ip            = "192.168.1.201"
    vm_id         = 101
    cpu           = 2
    ram_dedicated = 4096
    igpu          = false
    extra_labels = {
      "homelab.rosenvall.se/proxmox-host" = "desktop"
      "topology.kubernetes.io/zone"       = "desktop"
    }
  }
  "worker-01" = {
    host_node     = "pve"
    machine_type  = "worker"
    boot_disk_size_gib = 64
    ip            = "192.168.1.211"
    vm_id         = 201
    cpu           = 4
    ram_dedicated = 8192
    igpu          = false
    extra_labels = {
      "homelab.rosenvall.se/lan-special" = "true"
      "homelab.rosenvall.se/proxmox-host" = "desktop"
      "topology.kubernetes.io/zone"       = "desktop"
    }
  }
  # Example second physical host capacity node.
  # "worker-04" = {
  #   host_node          = "host1"
  #   machine_type       = "worker"
  #   longhorn_create_default_disk = false # host1 example has only a 30G Longhorn disk; keep it compute-only unless enlarged.
  #   boot_disk_size_gib = 32
  #   ip                 = "192.168.1.214"
